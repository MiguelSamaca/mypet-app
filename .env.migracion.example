# ============================================================
# Credenciales TEMPORALES para rescatar la BD de Mayte Pet Hotel
# desde el proyecto Supabase de Lovable (cvhzsanjnkmqzrjdgcjh).
#
# 1. Copia este archivo como  .env.migracion
# 2. Rellena los valores desde el dashboard de Supabase
#    (al que llegas por el botón de backend dentro de Lovable)
# 3. NO lo subas a git — ya está en .gitignore
# 4. Cuando la migración termine, bórralo
# ============================================================

# Settings -> Database -> Connection string -> URI  (modo "Session" / direct, puerto 5432)
# Formato: postgresql://postgres:[TU-PASSWORD]@db.cvhzsanjnkmqzrjdgcjh.supabase.co:5432/postgres
# Si no recuerdas la contraseña, usa "Reset database password" en esa misma pantalla.
ORIGEN_DB_URL=

# Settings -> API -> Project API keys -> service_role  (secret)
# Necesaria para bajar las fotos del bucket "peludos"
ORIGEN_SERVICE_ROLE_KEY=

# Ya lo sabemos, no hace falta cambiarlo
ORIGEN_PROJECT_REF=cvhzsanjnkmqzrjdgcjh
ORIGEN_URL=https://cvhzsanjnkmqzrjdgcjh.supabase.co
